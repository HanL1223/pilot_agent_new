# --- model (the harness owns these; pilot/config.py)
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                      # default: claude-sonnet-5 / gpt-5.6-luna
# LLM_SMALL_MODEL=                # default: claude-haiku-4-5-20251001 (gate, consolidation)
# LLM_REASONING_EFFORT=none       # openai only: none | low | medium | high
# LLM_MAX_TOKENS=16000

# --- harness
# PILOT_HOME=~/.pilot
# PILOT_MAX_ITERATIONS=12
# PILOT_MEMORY=1
# PILOT_CONSOLIDATE_EVERY=6
# PILOT_TRACE=1
# PILOT_OTEL=                     # console | otlp (needs: uv sync --extra tracing)

# --- dashboard
# PILOT_DASHBOARD_HOST=127.0.0.1  # anything else REQUIRES PILOT_API_TOKEN
# PILOT_API_TOKEN=
# PILOT_ALLOWED_HOSTS=

# --- telegram (pilot dashboard --telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=      # required, comma-separated numeric user ids

# --- the PO domain (pmagent/env.py)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CSCI
# JIRA_STORY_POINTS_FIELD=customfield_10052   # verify the customfield ids for your tenant
# JIRA_FLAGGED_FIELD=customfield_10021
# JIRA_SPRINT_FIELD=customfield_10020
# CONFLUENCE_SPACE_KEY=EDP
# FY_BUDGET_INPUT_DIR=data/fy_budget/input
# FY_BUDGET_OUTPUT_DIR=data/fy_budget/output
# SPREADSHEET_TENANT_ID=
# SPREADSHEET_CLIENT_ID=
# LUCID_MCP_ENABLED=false
