# Copy to .env and fill in. Never commit .env. Never reuse a .env that points at a real team's Jira.

# The model
LLM_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5        # default for anthropic; required for openai
# OPENAI_API_KEY=

# Jira Cloud — use a SANDBOX project while learning
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=                     # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=SBX

# Optional
# AGENT=jira_weather                 # which folder under agents/ to run
# AGENT_MAX_TURNS=10                 # model calls allowed per turn
# AGENT_HOME=.agent                  # where state.db and traces live
# LLM_MAX_TOKENS=8000               # longest reply allowed, in tokens
